{
	"name": "aghaaz",
	"version": "0.1.0",
	"description": "A CLI for scaffolding production-ready web applications based in reactjs, nextjs and nestjs",
	"type": "module",
	"bin": {
		"aghaaz": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"quality": "biome check .",
		"quality:fix": "biome check --write .",
		"ci:quality": "biome ci .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm run build"
	},
	"keywords": [
		"cli",
		"scaffolding",
		"react",
		"nextjs",
		"nestjs"
	],
	"author": "Zaryab Farooqui",
	"license": "MIT",
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"chalk": "^6.0.0",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
